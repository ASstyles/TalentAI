# ==============================================================================
# TalentAI Enterprise Docker Deployment Environment Template
# Copy this file to .env.docker before deploying with docker compose.
# WARNING: NEVER commit filled-in secrets or production private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client SDK (Browser-Visible Configuration)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server-Side Authoritative Credentials)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
# Format: Single-line with \n escaped newlines, or multi-line PEM formatted
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Models
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_FALLBACK=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. Redis Distributed Rate Limiting & Session Cache
# ------------------------------------------------------------------------------
REDIS_PASSWORD=change_this_to_a_secure_random_hex_password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ------------------------------------------------------------------------------
# 5. Isolated Sandbox Execution Worker (Separate MicroVM / Container Runtime)
# ------------------------------------------------------------------------------
# In production, point to your hardened gVisor / Firecracker / Cloud Run worker.
# Leave empty if code execution provider is not yet provisioned (returns 503).
SANDBOX_WORKER_URL=
SANDBOX_WORKER_SECRET=

# ------------------------------------------------------------------------------
# 6. Operational Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
