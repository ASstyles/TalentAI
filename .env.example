# Application Environment Variables Template
# DO NOT commit real API keys or credentials to version control

# Node Environment
NODE_ENV=development

# Gemini AI Configuration
# Real key must be obtained from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-4-neon
GEMINI_MODEL_REASONING=gemini-4-carbon
GEMINI_MODEL_FAST=gemini-4-hydrogen
GEMINI_MODEL_FALLBACK=gemini-3.8-flash

# Firebase Client SDK Configuration (Safe for client-side usage)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_APP_CHECK_KEY=

# Firebase Admin SDK Configuration (Server-side ONLY)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Security & Sandbox Settings
CODE_EXECUTION_TIMEOUT_MS=3000
CODE_EXECUTION_MEMORY_LIMIT_MB=128
ENABLE_APP_CHECK_DEBUG=true
