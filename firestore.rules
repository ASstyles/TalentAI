rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Zero-Trust authentication & authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isRecruiter() {
      return isAuthenticated() && (getUserRole() == 'recruiter' || isAdmin());
    }

    function isSameOrg(orgId) {
      return isAuthenticated() && request.auth.token.orgId == orgId;
    }

    // 1. Users Collection
    // Users can only read and update their own basic profile; cannot self-assign role or orgId
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'candidate');
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'orgId', 'status']);
      allow delete: if isAdmin();
    }

    // 2. Candidate Profiles
    // DEF-015 Remediation: Strictly private to candidate owner and admin.
    // Arbitrary recruiters cannot query dossiers directly via client SDK.
    // Recruiter dossier queries must route through authenticated server APIs validating active applications.
    match /candidateProfiles/{candidateId} {
      allow read: if isOwner(candidateId) || isAdmin();
      allow create: if isOwner(candidateId);
      allow update: if isOwner(candidateId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['overallVerificationScore', 'verifiedRecords', 'verifiedAt']);
      allow delete: if isAdmin();
    }

    // 3. Organizations
    // Organization-level isolation: only members or admins can view organization details
    match /organizations/{orgId} {
      allow read: if isSameOrg(orgId) || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Recruiter Profiles
    match /recruiterProfiles/{recruiterId} {
      allow read: if isOwner(recruiterId) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Job Openings
    // Published jobs are visible; draft/archived jobs are ONLY visible to that organization's recruiters
    match /jobOpenings/{jobId} {
      allow read: if resource.data.status == 'published' || (isRecruiter() && isSameOrg(resource.data.orgId)) || isAdmin();
      allow create: if isRecruiter() && isSameOrg(request.resource.data.orgId);
      allow update: if (isRecruiter() && isSameOrg(resource.data.orgId)) || isAdmin();
      allow delete: if (isRecruiter() && isSameOrg(resource.data.orgId)) || isAdmin();
    }

    // 6. Job Applications
    // Strictly restricted to applicant candidate, recruiters of THAT job's org, or admin
    match /jobApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isSameOrg(resource.data.orgId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.candidateId == request.auth.uid;
      allow update: if (isRecruiter() && isSameOrg(resource.data.orgId)) || isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Resumes (Private candidate metadata)
    match /resumes/{resumeId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isRecruiter() ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.candidateId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isAdmin()
      );
    }

    // 8. Candidate Projects
    match /candidateProjects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isRecruiter() ||
        isAdmin()
      );
      allow create, update, delete: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isAdmin()
      );
    }

    // 9. Independent Verifications
    // Candidates CANNOT tamper with or self-verify verification statuses
    match /verifications/{verificationId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isRecruiter() ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin(); // Server-side verification only
    }

    // 10. Technical Interviews & Turn-by-Turn Questions
    // Candidate cannot alter AI evaluation scores or rubric criteria
    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isRecruiter() ||
        isAdmin()
      );
      allow create: if isRecruiter() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /interviewQuestions/{questionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin(); // Server-side evaluation only
      allow delete: if isAdmin();
    }

    // 11. Coding Assessments & Submissions
    // DEF-013 Remediation: Hidden test cases isolated into private subcollection readable only by admin/server
    match /codingAssessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiter() || isAdmin();

      match /privateTestCases/{caseId} {
        allow read, write: if isAdmin();
      }
    }

    match /codingSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isRecruiter() ||
        isAdmin()
      );
      // Candidates cannot falsify their passedTests or execution score
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 12. Competencies & Evidence Scores
    match /competencies/{competencyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 13. Role Recommendations
    match /roleRecommendations/{recId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        isRecruiter() ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 14. Hiring Decisions & Recruiter Overrides
    // DEF-016 Remediation: Direct client writes strictly forbidden. All decisions must route through /api/hiring/decide via Admin SDK with atomic transaction and immutable audit log.
    match /hiringDecisions/{decisionId} {
      allow read: if isAuthenticated() && (isRecruiter() || isAdmin());
      allow write: if false;
    }

    // 15. Immutable Audit Logs & AI Usage
    // Clients CANNOT create, modify, or delete audit records or AI billing logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side admin SDK only
    }

    match /aiUsage/{usageId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side admin SDK only
    }

    // 16. Recruiter Access Requests
    // Applicants can submit pending requests; candidates cannot self-approve; only admins can inspect, approve, or reject
    match /recruiterAccessRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 17. Default Deny-All Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
