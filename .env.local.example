# Local Environment Configuration Template (.env.local.example)
# Copy this file to .env.local and populate with your local Firebase & Gemini keys.
# NEVER commit real credentials to source control.

NODE_ENV=development

# Firebase Client Configuration (Browser bundle safe)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK Configuration (Server-Side ONLY)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini AI Studio
GEMINI_API_KEY=

# Distributed Redis Rate Limiting
REDIS_URL=
REDIS_PASSWORD=

# Isolated Code Execution Sandbox
SANDBOX_WORKER_URL=
SANDBOX_WORKER_SECRET=
ALLOW_LOCAL_SUBPROCESS_SANDBOX=false
